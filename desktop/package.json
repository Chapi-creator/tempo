{
  "name": "tempo",
  "productName": "Tempo",
  "version": "1.4.4",
  "description": "Tablero Kanban offline que funciona sin internet",
  "author": "Chapi",
  "main": "main.js",
  "scripts": {
    "copy": "node copy.mjs",
    "fuses": "node fuses.mjs",
    "start": "npm run copy && electron .",
    "dist": "npm run copy && electron-builder --win --publish never",
    "publish": "npm run copy && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "com.tempo.board",
    "productName": "Tempo",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Chapi-creator",
        "repo": "tempo"
      }
    ],
    "fileAssociations": [
      {
        "ext": ["tempo.json"],
        "name": "Tablero Tempo",
        "description": "Tablero Kanban Tempo exportado",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Tempo-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}